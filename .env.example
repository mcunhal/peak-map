# Copy to .env, which is gitignored. Everything here is optional.

# Mapbox elevation source only. The app is fully usable without it.
VITE_MAPBOX_TOKEN=

# Default base URL for cached Portugal LiDAR tiles. This is only the default:
# the app carries a Tile cache field, remembered per browser, so a deployed page
# can be pointed at a bucket, at a server on your own network, or at nothing.
#
# The client does a plain anonymous GET of `<base>/<item-id>.tif` and needs CORS.
# There is no S3 API involved, so any static file server will do.
#
# Note that an https page cannot fetch an http base: serve tiles over https, or
# use the dev server. The app says so rather than reporting the tiles missing.
VITE_LIDAR_CACHE_URL=

# DGT Centro de Dados credentials, used ONLY by scripts/fetchLidar.mjs.
# Register at https://cdd.dgterritorio.gov.pt — the account is free.
#
# These must never reach anything in src/: the site is public, so a credential
# in the bundle is a credential handed to every visitor. The fetcher is a local
# script for exactly this reason.
DGT_USERNAME=
DGT_PASSWORD=
