    "vue": "^2.7.16",
    "vue-color": "^2.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.3",
    "stylus": "^0.63.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.127.1"
  }
}
