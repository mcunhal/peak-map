{
  "name": "peak-map-plotter",
  "version": "0.1.0",
  "description": "Plot-ready topographic line maps. Fork of anvaka/peak-map.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
